# The :core XCFramework is a build product: ./gradlew :core:assembleCoreDebugXCFramework
# writes it beside ios/CoreCrypto/Package.swift, where SwiftPM can see it.
ios/CoreCrypto/debug/
ios/CoreCrypto/.build/
ios/CoreCrypto/.swiftpm/
# Copies of repository files for phone test runs (ios/tools/stage-device-fixtures.sh).
ios/CoreCrypto/Sources/RepoFixtures/repo/*
!ios/CoreCrypto/Sources/RepoFixtures/repo/README.md

